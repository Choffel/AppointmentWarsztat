## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
# User-specific files
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.cache

# JetBrains Rider / IntelliJ IDEA / WebStorm / etc.
.idea/
*.iws
*.iml
*.ipr
out/
!.idea/workspace.xml  # keep for shared settings
!.idea/tasks.xml      # keep for shared tasks
!.idea/vcs.xml        # keep for VCS settings

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
artifacts/

# NuGet Packages
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
ehthumbs_vista.db
ehthumbs_vista.db:encryptable
ehthumbs.db:encryptable
*.swp
*.swo

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
pubspec_overrides.yaml
!pubspec.lock

# Android
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/local.properties
/android/.gradle
/android/captures/
/android/gradlew
/android/gradlew.bat
/android/gradlew
!android/app/src/main/res/values-night/

# iOS
ios/.symlinks/
ios/Flutter/.last_build_id
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh
ios/Pods/
ios/Podfile.lock
ios/Flutter/ephemeral

# Web (if applicable)
web/**/.last_build_id

# Logs
*.log
logs/
logs-*/

# Environment variables
.env
.env.local
.env.*.local

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
node_modules/
**/jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Flutter/Dart exceptions (keep these)
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages

# Docker
Dockerfile*
.dockerignore
!Dockerfile

# Secrets and keys
appsettings*.json
secrets.json
*.pfx
*.key